# Language Model Provider
LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-llm-model

# Telephony Provider
TELEPHONY_API_KEY=your-telephony-api-key
TELEPHONY_API_SECRET=your-telephony-api-secret

# Calendar Provider OAuth
CALENDAR_OAUTH_CLIENT_ID=your-calendar-client-id
CALENDAR_OAUTH_CLIENT_SECRET=your-calendar-client-secret
CALENDAR_OAUTH_REFRESH_TOKEN=your-calendar-refresh-token
CALENDAR_RESOURCE_EMAIL=calendar@example.com

# Scheduler Defaults
CALENDAR_BASE_LAT=47.6062
CALENDAR_BASE_LNG=-122.3321
CALENDAR_SERVICE_RADIUS_KM=45
CALENDAR_TRAVEL_SPEED_KMPH=48
CALENDAR_WORKDAY_START_HOUR=8
CALENDAR_WORKDAY_END_HOUR=18
CALENDAR_SLOT_INTERVAL_MINUTES=30
CALENDAR_SERVICE_URL=http://calendar-service:8000

# Mapping Provider
MAPS_API_KEY=your-maps-api-key
MAPS_REGION=your-maps-region
MAPPING_SERVICE_URL=http://mapping-service:8000

# Database Credentials
DATABASE_URL=postgresql://user:password@db:5432/voice_app
DATABASE_POOL_SIZE=10

# Notification Provider
NOTIFICATION_API_KEY=your-notification-api-key
NOTIFICATION_SENDER=notifications@example.com
NOTIFICATION_SENDER_NAME=Contractor Voice Assistant
NOTIFICATION_SENDER_PHONE=+15555550100

# Lead Store
LEAD_STORE_PATH=/data/lead_store.sqlite3
TENANT_ID=default-contractor

# Dashboard
DASHBOARD_SECRET_KEY=change-me-in-production
DASHBOARD_DB_PATH=/data/dashboard.sqlite3
